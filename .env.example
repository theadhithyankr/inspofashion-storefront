# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Public site URL used for metadata, robots, and sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional fallback only. Preferred source is Admin > Settings > WhatsApp Number.
NEXT_PUBLIC_WHATSAPP_PHONE=919876543210

# Instructions:
# 1. Copy this file to .env.local.
# 2. Add the same Supabase project URL and anon key used by the admin app.
# 3. Set NEXT_PUBLIC_SITE_URL to your Vercel/custom-domain URL in production.
# 4. Never add a Supabase service-role key to the storefront.
