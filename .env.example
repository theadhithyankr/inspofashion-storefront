# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# WhatsApp Configuration
VITE_WHATSAPP_PHONE=919876543210

# Application Configuration
VITE_APP_NAME=Fashion Store
VITE_CURRENCY_SYMBOL=$

# Instructions:
# 1. Copy this file to .env.local
# 2. Follow SUPABASE_SETUP.md to get your credentials
# 3. Replace the placeholder values with your actual Supabase URL and anon key
# 4. Set your WhatsApp number with country code (no spaces, no + symbol)
#    Example: 919876543210 for India, 1234567890 for US
# 5. Never commit .env.local to version control
